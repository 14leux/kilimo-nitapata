# Copy to .env.local (ignored by git). Vercel: add the same names under Project Settings, Environment Variables.

# Officer mode demo passcode. Not real auth, labelled as such in the UI.
OFFICER_PASSCODE=change-me

# Upstash Redis (Vercel Marketplace, or upstash.com). Both come from the database's REST API panel.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Twilio (trial is enough). Console home page shows SID and token.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio trial number, E.164, e.g. +12025550123
TWILIO_SMS_FROM=
# Twilio WhatsApp sandbox sender. Each demo phone must first send the join code to it.
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# Public URL of the deploy, used in message links. No trailing slash.
PUBLIC_BASE_URL=https://kilimo-nitapata.vercel.app
